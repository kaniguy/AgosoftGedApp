COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
TOKEN_TTL_HOURS=12
# logs fichier désactivés en prod (décommenter seulement en local)
# GED_FILE_LOGS=true
CORS_ALLOWED_ORIGINS=http://203.0.113.10:3001,http://127.0.0.1:3001,http://localhost:3001
THROTTLE_RATE_LOGIN=5/min
THROTTLE_RATE_DOWNLOAD_LINK=30/hour
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_NUMBER_FIELDS=2000
MAX_IMAGE_UPLOAD_SIZE=5242880
MAX_DOCUMENT_UPLOAD_SIZE=26214400

DB_NAME=DB_AgosoftGed
