# ============================================================
# MODELE UNIQUEMENT — ne pas utiliser tel quel.
# Copier vers .env : copy backend_ged\config\.env.example backend_ged\config\.env
# Remplacer toutes les valeurs <...> par les vôtres.
# Le vrai fichier de config est : backend_ged\config\.env (non versionné dans Git)
# ============================================================

SECRET_KEY=<generer-une-cle-secrete-longue>
# Clé AES-256 (32 octets en base64) pour chiffrer les documents sur disque
# Générer : python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
DOCUMENT_ENCRYPTION_KEY=<generer-cle-aes-256-base64-32-octets>
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,<votre-ip-lan>,backend,agosoftged-backend
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# --- Throttling API (login uniquement — protection brute-force) ---
THROTTLE_RATE_LOGIN=5/min
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_NUMBER_FIELDS=2000
MAX_IMAGE_UPLOAD_SIZE=5242880
MAX_DOCUMENT_UPLOAD_SIZE=26214400

# --- SQL Server LOCAL ---
# Docker : connexion dans docker-compose.yml (host.docker.internal:1433) — rien à changer ici
# Django local (sans Docker) : renseigner NOM_PC\INSTANCE ci-dessous
DB_NAME=DB_AgosoftGed
DB_HOST=<NOM_PC>\<INSTANCE_SQL>
DB_PORT=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_USER=sa
DB_PASSWORD=<mot-de-passe-sa>

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=GED <noreply@localhost>
