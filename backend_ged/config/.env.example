# Copier vers backend_ged/config/.env
# copy backend_ged\config\.env.example backend_ged\config\.env

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.24,backend,agosoftged-backend
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://192.168.1.24:3000,http://192.168.1.24:3001
THROTTLE_RATE_LOGIN=5/min
THROTTLE_RATE_ANON=10/min
THROTTLE_RATE_USER=300/hour
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
DATA_UPLOAD_MAX_NUMBER_FIELDS=2000
MAX_IMAGE_UPLOAD_SIZE=5242880
MAX_DOCUMENT_UPLOAD_SIZE=26214400

# --- SQL Server LOCAL (instance nommee) ---
# Depuis le conteneur, utiliser host.docker.internal\AGOSOFTGED
DB_NAME=DB_AgosoftGed
DB_HOST=host.docker.internal\AGOSOFTGED
DB_PORT=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_USER=sa
DB_PASSWORD=P@ssword2026

# Si vous lancez Django sans Docker sur ce PC, utiliser plutôt l'instance locale :
# DB_HOST=DESKTOP-VE18TAC\AGOSOFTGED

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=GED <noreply@localhost>
