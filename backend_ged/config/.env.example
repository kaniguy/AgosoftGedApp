# copier vers .env — remplacer 203.0.113.10 par l'ip du serveur

SECRET_KEY=<generer-une-cle-secrete-longue>
DOCUMENT_ENCRYPTION_KEY=<generer-cle-aes-256-base64-32-octets>
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,203.0.113.10,backend,agosoftged-backend
FRONTEND_URL=http://203.0.113.10:3001
CSRF_TRUSTED_ORIGINS=http://203.0.113.10:3001,http://127.0.0.1:3001,http://localhost:3001
