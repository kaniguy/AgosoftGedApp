# ============================================================
# Secrets, données perso, artefacts locaux — ne pas commiter
# ============================================================

# Secrets / config machine (mots de passe, clés, IPs)
.env
.env.*
*.env
*.env.local
!.env.example
!**/.env.example
backend_ged/config/.env
frontend_ged/.env*

# Clés, certificats, identifiants
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
id_rsa
id_rsa.pub
*.ppk
credentials.json
secrets.json

